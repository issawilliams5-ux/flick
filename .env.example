# Copy to .env and fill in only the keys you actually need. Never commit .env.
# Every value below is a secret — keep it out of git, scene files, and scene-spec.json.

# --- Flick: ai-clip engine (MuAPI provider) ---
# Only needed for scenes whose engine is `ai-clip` with provider MuAPI.
# HIGGSFIELD uses its MCP connector instead and needs no variable here.
MUAPI_KEY=

# --- ui-from-screenshot skill: screenshot/prompt -> UI code ---
# screenshot-to-code needs at least one of OPENAI_API_KEY / ANTHROPIC_API_KEY.
# OpenUI accepts any one of the keys below, or OLLAMA_HOST for a local model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
